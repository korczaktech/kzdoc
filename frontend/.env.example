# Korczak Nexus Google Drive OAuth
# Google Cloud OAuth Client ID for a Web application.
GOOGLE_CLIENT_ID=

# OAuth redirect URI must match the deployed Nexus origin/path.
# For GitHub Pages, use the exact Nexus PWA URL shown in the browser.

# Optional: exact OAuth redirect URI registered in Google Cloud Console.
# If omitted, Nexus uses the current page origin + pathname.
VITE_GOOGLE_REDIRECT_URI=
